{
  // Cloudflare Workers Builds requires a Wrangler config whose `name`
  // matches the dashboard Worker ("reliantai"). This site is a static
  // Vite SPA — build with Vite, then serve dist/ with SPA fallback.
  "name": "reliantai",
  "compatibility_date": "2026-07-21",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
