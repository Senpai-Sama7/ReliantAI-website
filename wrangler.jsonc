{
  // Cloudflare Workers Builds requires a Wrangler config whose `name`
  // matches the dashboard Worker ("reliantai").
  //
  // Note: Workers Builds ignores wrangler `build.command`. CI creates dist/
  // via scripts/workers-ci-build.mjs (postinstall when WORKERS_CI=1).
  // `build.command` still helps local `wrangler deploy` / `versions upload`.
  "name": "reliantai",
  "compatibility_date": "2026-07-21",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

