# Web3Forms API key — get yours at https://web3forms.com
VITE_WEB3FORMS_KEY=your_key_here

# ── Tier 3 Operational Automation credential audit ──────────────────────────
# Used by: npm run validate:credentials
# Never commit real tokens. Prefer a Private App / scoped key with least privilege.

# HubSpot Private App access token (crm.objects.contacts.read minimum)
HUBSPOT_APP_ACCESS_TOKEN=

# Cal.com API key (Settings → Security). Prefer cal_live_… / cal_… keys for API v2.
SCHEDULING_API_KEY=

# Slack Incoming Webhook URL (https://hooks.slack.com/services/…)
NOTIFICATION_ROUTING_WEBHOOK=

# Optional overrides for partial audits during onboarding:
# SKIP_HUBSPOT=1
# SKIP_SCHEDULING=1
# SKIP_SLACK=1
# SLACK_HANDSHAKE=0
